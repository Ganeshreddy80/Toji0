# ============================================================================
# Toji — Environment Variable Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ============================================================================

# ── Binance Exchange Credentials ───────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Binance Endpoints ──────────────────────────────────────────────────────
BINANCE_BASE_URL=https://demo-api.binance.com/api
BINANCE_WS_URL=wss://demo-stream.binance.com/ws

# ── Trading Configuration ──────────────────────────────────────────────────
TRADING_MODE=paper
DEFAULT_EXCHANGE=binance
MARKET_PROVIDER=binance_live

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Market Intelligence ────────────────────────────────────────────────────
DEFILLAMA_ENABLED=true
DEFILLAMA_BASE_URL=https://api.llama.fi

# ── AI Reasoning Layer ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Telegram Alerts ────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Database Config ────────────────────────────────────────────────────────
# DEV can use a local DATABASE_URL. PAPER/PROD should set these non-secret
# selectors and let the EC2 IAM role read the JSON value from Secrets Manager.
AWS_REGION=us-east-1
TOJI_DATABASE_SECRET_NAME=your-rds-database-secret-name
DATABASE_MODE=DEV
DATABASE_URL=postgresql+asyncpg://toji:YOUR_DATABASE_PASSWORD@localhost:5432/toji

# ── Redis Config ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Runtime ────────────────────────────────────────────────────────────────
TOJI_MODE=PAPER
ENABLE_LIVE_TRADING=false
NEWS_API_KEY=your_news_api_key_here

# ── Dashboard API Keys ─────────────────────────────────────────────────────
TOJI_ADMIN_API_KEY=change_this_admin_key_in_prod
TOJI_ANALYST_API_KEY=change_this_analyst_key_in_prod
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT

# ── FP-3D: Position Sizing — Canonical Volatility (Sprint 004) ─────────────
# Target annualized portfolio volatility for the volatility-sizing method.
# Units: dimensionless annualized fraction (0.10 = 10%/year).
# Multi-asset safe default — do NOT calibrate to a single asset's typical vol.
TARGET_VOLATILITY=0.10

# Maximum leverage scalar from the volatility formula before exposure caps.
# Formula: scale = min(target_volatility / annualized_vol, MAX_LEVERAGE)
# Consistent with VolatilityTargetingEngine and PortfolioRebalancer (both use 2.0).
MAX_LEVERAGE=2.0

# Fallback annualized volatility used when Feature Platform is unavailable or in warm-up.
# 0.50 = 50%/year — conservative risk-policy estimate, NOT a measured market value.
# At this fallback, sizing = 0.10 / 0.50 = 0.20x equity per position (safe).
FALLBACK_VOLATILITY=0.50
