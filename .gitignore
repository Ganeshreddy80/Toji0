# ============================================================================
# Toji — .gitignore
# Production-grade ignore rules for quantitative research platform
# ============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-wheel-metadata/
*.manifest
*.spec
MANIFEST

# ── Virtual Environments ───────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.env
.env.local
.env.*.local

# ── IDE / Editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace

# ── Testing ────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml

# ── Type Checking ──────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Docker ─────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Database ───────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log

# ── Data ───────────────────────────────────────────────────────────────────
data/*
!data/.gitkeep
!data/__init__.py
!data/market/
!data/feature_store/
!data/datasets/
!data/providers/
!data/storage/
!data/quality/
!data/schemas/
!data/time_machine/
!data/metadata/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Secrets ────────────────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
secrets/
.secrets/

# ── Misc ───────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
tmp/

# ── Generated Artifacts ────────────────────────────────────────────────────
# Test runner output, audit dumps, and other generated files must not be
# committed. Add any new generated file patterns here.
pytest_out.txt
di_audit_raw.json
workspace_audit_raw.json
*.audit.json
data/reports/
